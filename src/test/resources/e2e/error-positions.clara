// an unknown type is reported at the name itself, wrong type args at the whole type
// (type errors in a scope stop its values from being analyzed, see error-positions-values)
::namespace Outer {
  ::namespace Inner {
    ::alias Unit: ()
    ::alias Pair<A, B>: (A, B)
  }
}

missingType: Outer.Inner.Foo<()> = ()
tooManyArgs: Outer.Inner.Unit<()> = ()
tooFewArgs: Outer.Inner.Pair<()> = ()
()
