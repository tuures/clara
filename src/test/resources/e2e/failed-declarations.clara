// a duplicate or a declaration that failed loses only itself: the name stays taken, the body is still analyzed in a
// namespace of its own, so the errors of every declaration are reported at once, without follow-up errors

::singleton Flag
::extend Flag {
  ::alias Bad: Unknown1
}

::singleton Failed<A>
::extend Failed {
  ::alias Member: ()
  ::alias Other: Member
  ::alias Bad: Unknown2
}
::alias Failed: ()
::alias UsesFailed: Failed

::namespace Space {
  ::alias Member: ()
}
::namespace Space {
  ::alias Member: ()
  ::alias Other: Member
  ::alias Bad: Unknown3
}

::declare Id: ()
::tagged Id: ()

value = ()
::declare value: Unknown4

// its annotation is reported once, what uses it gets no follow-up errors
annotated: Unknown5 = ()
usesAnnotated: Failed = annotated
missing = nope
usesMissing = missing(())
()
