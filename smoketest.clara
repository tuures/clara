//   FooId _ => "Foo"
//   BarId _ => "Bar"
// )

//(isFooOrBar(fooId), isFooOrBar(barId))


//////
// Methods, Member selection, Pipe

// TODO fix methods
//::methods Boolean b: {
//  thenElse =...
//  and = ... how to deal with short circuiting?
//  or = ...
//}

::declare ::methods String: {
  @[emitKind instanceProperty]
  length: Int
}

::methods Boolean b: {
  not = b @ #(
    True => False
    False => True
  )
}

